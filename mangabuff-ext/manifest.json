{
  "manifest_version": 3,
  "name": "MangaBuff Cards Plus",
  "version": "1.0.0",
  "description": "Расширенная аналитика, медианные цены и статистика карточек на MangaBuff",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://mangabuff.ru/*",
        "*://www.mangabuff.ru/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ]
}